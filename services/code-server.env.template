# ─────────────────────────────────────────────────────────────────────────────
# code-server service — Railway variables
# Paste these into the Railway template composer (service → Variables →
# Raw Editor) or into a deployed service. Lines starting with # are comments.
#
# Railway template syntax notes:
#   ${{ secret(24) }}            → Railway generates a 24-char random secret
#                                  at deploy time (template composer feature)
#   ${{ RAILWAY_PUBLIC_DOMAIN }} → the service's own public domain
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — login password for the web IDE. Auto-generated per deploy.
# The entrypoint refuses to boot without PASSWORD or HASHED_PASSWORD set.
PASSWORD=${{ secret(24) }}

# OPTIONAL (preferred after setup) — argon2 hash; takes precedence over
# PASSWORD. Generate inside the box:  echo -n "pw" | npx argon2-cli -e
# Then set this, DELETE PASSWORD above, and redeploy. See SECURITY.md.
# HASHED_PASSWORD=

# OPTIONAL — folder code-server opens by default (lives on the volume).
WORKSPACE_DIR=/home/coder/project

# OPTIONAL — bind port. Must match the public domain's target port.
# Railway may inject PORT automatically; 8080 is the template default.
# PORT=8080

# OPTIONAL — block file downloads through the UI (exfiltration guard).
# CS_DISABLE_FILE_DOWNLOADS=true

# OPTIONAL — shut code-server down after N idle seconds (must be > 60).
# Pairs well with Railway App Sleeping to cut cost to near-zero when idle.
# CODE_SERVER_IDLE_TIMEOUT_SECONDS=7200

# ─────────────────────────────────────────────────────────────────────────────
# Service settings that are NOT env vars (set in the composer/service UI):
#   Volume:            mount path  /home/coder
#   Healthcheck path:  /healthz    (timeout 300s recommended for first boot)
#   Domain:            generate public domain, target port 8080
#   Restart policy:    ON_FAILURE
# ─────────────────────────────────────────────────────────────────────────────
